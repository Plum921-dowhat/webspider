# 复制为 .env 并按需填写（compose 自动加载）
# Stack Exchange 免费 API key：https://stackapps.com/apps/oauth/register
# （无需走 OAuth 流程，注册后页面直接给出 key），配额 300 → 10k 请求/天
SE_API_KEY=

# 爬虫 UA：长期运行前填入真实联系方式（邮箱或问题页），上游据此联系而非封禁。
# Go 爬虫读 CRAWLER_USER_AGENT，处理器抓取读 FETCH_UA。
CRAWLER_USER_AGENT=WebSpider/0.2 (+contact: your-email@example.com)
FETCH_UA=en-tech-corpus-bot/1.0 (+contact: your-email@example.com)

# RAG 语义检索 / embedding（OpenAI 兼容接口）
# SiliconFlow: https://cloud.siliconflow.cn 拿 key，模型 BAAI/bge-m3 (1024 维)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 看板访问控制（可选）：设置后 /api/* 需要 Bearer <DASH_TOKEN>
DASH_TOKEN=
